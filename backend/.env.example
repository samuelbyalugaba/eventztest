# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/eventz

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

# Kafka
KAFKA_BROKERS=localhost:9092

# Supabase (for migration period)
SUPABASE_URL=https://qxtqpbgtkymkshxzryzw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# nTZS
NTZS_API_KEY=your-api-key
NTZS_SECRET=your-secret

# Agora
AGORA_APP_ID=your-app-id
AGORA_APP_CERTIFICATE=your-certificate

# Cloudflare Stream
CLOUDFLARE_STREAM_TOKEN=your-token
CLOUDFLARE_ACCOUNT_ID=your-account-id

# Sentry
SENTRY_DSN=your-dsn
